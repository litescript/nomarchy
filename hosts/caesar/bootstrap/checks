# caesar state that is not a file or a unit. Format: see common/stages/base/checks --
# `probe` runs with no sudo and exits 0 when right; `fix` may use sudo.

# ufw generates /etc/ufw/user.rules (0644, so no sudo) and writes each rule into it as a
# `### tuple ###` line. The probe compares that set, comments stripped, to EXACTLY the rules
# apply-rules adds, so a rule added by hand is reported as well as one that went missing.
# It asked only "is ufw on" until 2026-11-14, which let a hand-added `allow tcp 80 from
# 192.168.1.101` sit there unreported (removed: nothing answers at .101 any more). Editing
# apply-rules means editing the list below to match; until then status says to-do.
# apply-rules is idempotent; rerun it by hand after editing it.
check firewall enabled, rules exactly apply-rules' (hosts/caesar/ufw/apply-rules)
  probe grep -q '^ENABLED=yes' /etc/ufw/ufw.conf && systemctl is-enabled -q ufw.service && diff <(sed -n 's/^### tuple ### //p' /etc/ufw/user.rules | sed 's/ comment=.*//' | sort) <(printf '%s\n' 'allow tcp 22 0.0.0.0/0 any 192.168.1.0/24 in' 'allow udp 6666 0.0.0.0/0 any 192.168.1.50 in' | sort)
  fix   sudo hosts/caesar/ufw/apply-rules

# The monuser password lives in upsmon.conf, so the file is created by hand and never
# committed. Its EXISTENCE proves nothing -- the nut package ships a stock upsmon.conf, with
# no MONITOR line. Nor does upsmon RUNNING: this probe used to be exactly that, and it said
# ok for the five days after the cutover (2026-09-29 to 10-04) while upsd refused caesar
# twice over -- Proxmox's ufw dropping 3493, then a monuser password that did not match.
# upsmon stays up through both. So the probe asks upsd itself whether caesar is among its
# logged-in monitors; `upsc -c` needs no credentials, and .200 is asserted by the address
# check below. Bare upsc gives up on a dropped port after 10 s; timeout keeps `status` quick.
check UPS monitor (NUT) logged in to Proxmox's upsd
  probe systemctl is-active -q nut-monitor.service && timeout 5 upsc -c cyberups@192.168.1.50 2>/dev/null | grep -Eqx '(::ffff:)?192\.168\.1\.200'
  manual no /etc/nut/upsmon.conf: follow hosts/caesar/nut/upsmon.conf.example. Otherwise read `journalctl -u nut-monitor`: "Connection timed out" = Proxmox's ufw must allow 3493/tcp from 192.168.1.200; "ERR ACCESS-DENIED" = the password is not [monuser]'s in Proxmox's /etc/nut/upsd.users (copy it as the example shows)
# caesar is 192.168.1.200 -- netconsole, ufw, the NAS exports and every ssh alias assume
# it. The ROUTER owns that, by a DHCP reservation for caesar's MAC; nomarchy only says when
# it is not so, and never configures an address to make it so (manifest §0).
check caesar has its reserved address, 192.168.1.200/24
  probe ip -4 -o addr show | grep -q ' inet 192\.168\.1\.200/24 '
  manual the router's DHCP reservation gives caesar .200 -- check it there (a new NIC means a new MAC), never set it here
