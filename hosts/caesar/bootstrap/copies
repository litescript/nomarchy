# Root-owned copies: <source>  <system path>  [mode, default 0644]  [owner:group]
#
# The source is a repo path, or a path inside a declared build checkout (~/code/irides/...).
#
# These cannot be symlinks -- a mount unit for /mnt/nas has to be a system unit, and
# /etc is not ours to link into. So they are copies, and copies drift silently, which is
# the failure mode this repo keeps warning about. `nomarchy status` diffs them and reports
# drift as a conflict; `nomarchy install host` installs what is missing or different,
# showing the diff first, and runs whatever reload each path needs.
#
# Deliberately absent: hosts/caesar/noctalia/settings.toml. Noctalia rewrites that file
# itself, so the repo copy is a snapshot and is EXPECTED to be behind. Flagging it would
# train the eye to ignore this section.
common/systemd/mnt-nas.mount		/etc/systemd/system/mnt-nas.mount
common/systemd/mnt-nas.automount	/etc/systemd/system/mnt-nas.automount
hosts/caesar/ssh/10-nomarchy.conf	/etc/ssh/sshd_config.d/10-nomarchy.conf
common/udev/99-streamdeck-no-keyboard.rules	/etc/udev/rules.d/99-streamdeck-no-keyboard.rules
hosts/caesar/netconsole/netconsole-listener.service	/etc/systemd/system/netconsole-listener.service
hosts/caesar/netconsole/netconsole-proxmox.logrotate	/etc/logrotate.d/netconsole-proxmox
hosts/caesar/modprobe/nvidia.conf	/etc/modprobe.d/nvidia.conf
hosts/caesar/systemd/zram-generator.conf	/etc/systemd/zram-generator.conf
hosts/caesar/systemd/logind-nomarchy.conf	/etc/systemd/logind.conf.d/10-nomarchy.conf
hosts/caesar/nss/nsswitch.conf	/etc/nsswitch.conf
hosts/caesar/nut/nut.conf	/etc/nut/nut.conf
# Irides' lighting rule: hidraw access for the G213, G502 and ASUS Aura it drives, and a
# re-theme when one appears (irides-lighting.service, enabled in ./units). The
# rule is Irides' file, so it is installed from the Irides checkout, not duplicated here.
# It superseded nomarchy's own 70-logitech-g213.rules (keyboard-rgb's, retired 2026-09-28),
# whose one rule is the first line of this one.
~/code/irides/data/udev/70-irides-lighting.rules	/etc/udev/rules.d/70-irides-lighting.rules
