# Root-owned copies: <repo path>  <system path>  [mode, default 0644]
#
# These cannot be symlinks -- /etc and /boot are not ours to link into. Copies drift
# silently, which is the failure mode this repo keeps warning about, so `nomarchy status`
# diffs them and `nomarchy install host` installs what differs, showing the diff first.
#
# The lid decision, made 2026-10-04 (design A): logind owns the lid and Noctalia's
# lock_before_suspend owns the lock. The two systemd files are that decision plus
# hibernation; read the header of ../systemd/logind-nomarchy.conf.
hosts/rigel/systemd/logind-nomarchy.conf	/etc/systemd/logind.conf.d/10-nomarchy.conf
hosts/rigel/systemd/sleep-nomarchy.conf		/etc/systemd/sleep.conf.d/10-nomarchy.conf
# The LTS fallback kernel's boot entry (the package is in ../packages/repo.txt). 0755, not
# the default: /boot is FAT, mounted fmask=0022, so every file there reads root:root 755
# and a chmod to anything else is refused.
hosts/rigel/boot/arch-lts.conf			/boot/loader/entries/arch-lts.conf	0755
# hibernate-guard: hibernation is turned off (in /run, until reboot) whenever a resume would
# boot a different kernel than the one running -- after a `linux` upgrade, or booted on LTS.
# The script, the pacman hook that runs it after mkinitcpio, and the unit that runs it at boot.
hosts/rigel/hibernate-guard/hibernate-guard		/usr/local/bin/hibernate-guard		0755
hosts/rigel/hibernate-guard/95-hibernate-guard.hook	/etc/pacman.d/hooks/95-hibernate-guard.hook
hosts/rigel/hibernate-guard/hibernate-guard.service	/etc/systemd/system/hibernate-guard.service
