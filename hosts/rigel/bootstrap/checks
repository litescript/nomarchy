# rigel state that is not a file or a unit. Format: see common/stages/base/checks --
# `probe` runs with no sudo and exits 0 when right; `fix` may use sudo.

# ufw generates /etc/ufw/user.rules, and writes each rule into it as a `### tuple ###` line,
# so the probe asks for the ssh rule itself, not only whether the firewall is on: a firewall
# that is enabled but lost the rule is the case worth reporting. apply-rules is idempotent;
# rerun it by hand after editing it.
check firewall enabled, ssh admitted from the LAN (hosts/rigel/ufw/apply-rules)
  probe grep -q '^ENABLED=yes' /etc/ufw/ufw.conf && systemctl is-enabled -q ufw.service && grep -q '^### tuple ### allow tcp 22 0.0.0.0/0 any 192.168.1.0/24 in' /etc/ufw/user.rules
  fix   sudo hosts/rigel/ufw/apply-rules
