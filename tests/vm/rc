  check "accept-remote refuses while the agent holds no keys (it cannot prompt)" \
    vm_expect 'cd ~/Projects/nomarchy && SSH_AUTH_SOCK=/nonexistent migrate/migrate caesar accept-remote; echo exit=$?' 'the agent holds no keys' 'exit=1'

  step "Noctalia's settings after first start: the seed must have carried everything"
  # A VM has different displays from caesar, so Noctalia adds widgets for its own (Virtual-1)
  # and the repo-capture check cannot pass here. What CAN be proven: that the only drift from
  # the seeded settings is the VM's display. Then the operator's "review and commit" step is
  # stood in for by snapshotting in the VM's own clone -- never pushed anywhere.
  check "Noctalia's seed carried every setting: the only drift is the VM's display" vm_ssh 'cd ~/Projects/nomarchy && d=$(diff <(awk "/^\[location\]/{s=1;next} /^\[/{s=0} !s" ~/.local/state/noctalia/settings.toml) hosts/caesar/noctalia/settings.toml | grep "^<" | grep -vE "Virtual-1|^< *\]$|^< *\"lockscreen-login-box@|^< *widget_order = \[$|^< *$|^< +(box_|cx|cy|output|placement_|rotation|type|background_|center_|input_|layout|show_)"); echo "$d"; [ -z "$d" ]'
  vm_ssh 'cd ~/Projects/nomarchy && common/scripts/noctalia-snapshot >/dev/null' >>"$LOG" 2>&1

  step "nomarchy link, after first login (the Noctalia-side checks)"
  check "nomarchy link --yes after first login" vm_ssh 'cd ~/Projects/nomarchy && common/scripts/nomarchy link --yes'

  step "NVRAM: finalize, now that the new system has proven itself"
  vm_tty 'y
' 'cd ~/Projects/nomarchy && sudo provision/provision caesar --finalize-nvram' >>"$LOG" 2>&1
  check "our entry first in BootOrder; rescue and Windows entries intact" \
    vm_ssh 'o=$(efibootmgr); n=$(sed -n "s/^Boot\([0-9A-F]*\)\*\? Nomarchy (caesar XPG).*/\1/p" <<<"$o"); grep -q "^BootOrder: $n" <<<"$o" && grep -q " Nomarchy$\| Nomarchy	" <<<"$o" && grep -q "Windows Boot Manager" <<<"$o"'

  step "Snapper recovery"
  check "tests/snapper-recovery" vm_ssh 'cd ~/Projects/nomarchy && tests/snapper-recovery'

  step "final nomarchy status"
  vm_ssh 'cd ~/Projects/nomarchy && common/scripts/nomarchy status' > "$WD/logs/rc-$stamp-status.log" 2>&1
  cat "$WD/logs/rc-$stamp-status.log" >>"$LOG"
  local summary; summary=$(sed 's/\x1b\[[0-9;]*m//g' "$WD/logs/rc-$stamp-status.log" | grep -E '^[0-9]+ ok, ' | tail -1)
  # Exactly the two things a VM must not have: caesar's LAN address and Pete's GPG key.
  local todo expected
  todo=$(sed 's/\x1b\[[0-9;]*m//g' "$WD/logs/rc-$stamp-status.log" | grep -E '^\s+→ ' | sed 's/^\s*→ //' | LC_ALL=C sort)
  expected=$(printf '%s\n' 'GPG secret key 8B52A5D2637434B3 (pass decrypts with it) -- by hand, see below' \
    'caesar has its reserved address, 192.168.1.200/24 -- by hand, see below' | LC_ALL=C sort)
  check "status: 0 conflicts, and to do ONLY caesar's address and the GPG key  ($summary)" \
    bash -c '[[ $1 == "$2" ]] && grep -qE "^[0-9]+ ok, 2 to do, 0 conflicts" <(sed "s/\x1b\[[0-9;]*m//g" "$3")' _ "$todo" "$expected" "$WD/logs/rc-$stamp-status.log"
  check "no orphaned packages after every stage (makepkg --rmdeps)" vm_ssh 'o=$(pacman -Qdtq); echo "$o"; [ -z "$o" ]'
  check "the keep-untouched stand-in: never mounted by the new system, byte-identical to before" \
    vm_ssh "! findmnt -S /dev/disk/by-id/$FREE_ID-part1 >/dev/null && [ \"\$(sudo sha256sum /dev/disk/by-id/$FREE_ID-part1 | cut -d' ' -f1)\" = $(cat "$WD/freespace.sha") ]"
  check "umbriel at the exact pins" grep -q 'umbriel and its portal installed at the pinned revisions' <(sed 's/\x1b\[[0-9;]*m//g' "$WD/logs/rc-$stamp-status.log" | grep '✓')
  check "umbriel accepts the live config (incl. Noctalia's palette)" grep -qi 'accepts the live config' <(sed 's/\x1b\[[0-9;]*m//g' "$WD/logs/rc-$stamp-status.log" | grep '✓')

  printf '\n\033[1mRelease-candidate result (%s)\033[0m\n' "$(git -C "$repo" rev-parse --short HEAD)" | tee -a "$LOG"
  printf '  tested with: %s\n' "$(vm_ssh 'pacman -Q noctalia umbriel-git xdg-desktop-portal-umbriel-git linux | tr "\n" " "')" | tee -a "$LOG"
  printf '  %s\n' "${RESULTS[@]}" | tee -a "$LOG"
  printf '  not done / to do in the final status:\n' | tee -a "$LOG"
  sed 's/\x1b\[[0-9;]*m//g' "$WD/logs/rc-$stamp-status.log" | grep -E '^\s+(→|✗)' | sed 's/^/    /' | tee -a "$LOG"
  say "log: $LOG  (the VM is left running: tests/vm/rc ssh / stop)"
}

gui() {
  [[ -f $WD/xpg.raw ]] || die "no machine"
  running && die "a VM is running -- 'tests/vm/rc stop' first"
  say "booting the target in a window, WITHOUT the passphrase credential."
  say "At the Plymouth prompt, type the VM-ONLY passphrase: $(cat "$WD/vm-secrets/luks-passphrase")"
  qemu target gui
}

cmd=${1:-}; shift || true
# Run as the user: build calls sudo itself for the one step that needs root, and everything
# else -- the disks, the harness key, the VM secrets -- must belong to the user who runs the
# rehearsal. A whole `sudo tests/vm/rc build` left all of it root-owned and unreadable.
case $cmd in build|run|gui|rescue|target) ((EUID != 0)) || die "run tests/vm/rc as your user, not with sudo -- it asks for sudo itself where it must" ;; esac
case $cmd in
  build) build ;;
  run) run ;;
  gui) gui ;;
  rescue) running && die "a VM is running"; [[ -f $WD/env.qcow2 ]] || fresh_state; qemu env; wait_ssh || die "rescue did not come up"; say "rescue up: tests/vm/rc ssh" ;;
  # Inspection only: bootindex makes OVMF prefer the XPG, sidestepping the NVRAM order the
  # rehearsal itself must exercise.
  target) running && die "a VM is running"; qemu target inspect; wait_ssh 180 || die "target did not come up"; say "target up: tests/vm/rc ssh" ;;
  ssh) running || die "no VM running"; exec ssh -F /dev/null -p "$PORT" -i "$WD/id_ed25519" -o LogLevel=ERROR \
         -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null peter@127.0.0.1 "$@" ;;
  stop) stop_vm; say "stopped" ;;
  destroy) stop_vm; [[ $WD == /var/tmp/* || -n ${NOMARCHY_RC_DIR:-} ]] || die "refusing to delete $WD"; rm -rf -- "$WD"; say "deleted $WD" ;;
  *) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
