# Nightly .srt sidecar sync. Ported from the old box on 2026-09-13.
#
# ExecStart moved into the checkout; ~/.local/bin/subget is a symlink to the same file, so
# the interactive command and the timer run identical code. Everything else, including the
# reasoning below, is the original's.

[Unit]
Description=Sync .srt sidecars across the Plex library
# Only meaningful when the NAS is actually mounted.
#
# Caveat on this box, which the old one did not have: /mnt/nas is now a systemd automount,
# so autofs holds the path and this condition is true whether or not NFS is live. It is
# kept because it costs nothing and stays correct if the automount is ever dropped, but it
# is not the safety net it reads as. subget itself fails fast on an unreachable NAS.
ConditionPathIsMountPoint=/mnt/nas

[Service]
Type=oneshot
# Extraction reads whole files off the NAS at line rate, so the run is hard-stopped rather
# than allowed to overrun into the backup window; remaining files are picked up the
# following night. This must be TimeoutStartSec and not RuntimeMaxSec: systemd ignores the
# latter for Type=oneshot, which would leave the run unbounded.
#
# 9900s from 00:00 lands at 02:45, clearing the 03:00 NAS backups. Those are NOT this
# machine's timers -- they are the Proxmox host on the network dumping its VMs to the same
# NAS nightly. That is why the deadline is what it is, and why it must not be relaxed to
# suit anything local: the contended resource is the NAS and its network, and the other
# party does not know this job exists. (caesar's own backups run at 02:20 and 05:00.)
TimeoutStartSec=9900
# Pinned rather than inherited: the user manager's PATH comes from the graphical session,
# so a headless or early-boot start would not find subliminal in ~/.local/bin.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Nice=10
IOSchedulingClass=idle
ExecStart=%h/.local/bin/subget -l vi -l en
StandardOutput=append:%h/Logs/subget-sync.log
StandardError=append:%h/Logs/subget-sync.log
