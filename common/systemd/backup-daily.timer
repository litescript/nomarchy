# Carried over unchanged from the old box.
#
# Persistent=true: if the machine was off at 05:00, run on next boot. Correct for a
# backup -- a missed one should still happen -- and the opposite of what subget-sync
# wants, where a late run would collide with the backup window.

[Unit]
Description=Run daily backups at 05:00

[Timer]
OnCalendar=*-*-* 05:00:00
Persistent=true
Unit=backup-daily.service

[Install]
WantedBy=timers.target
