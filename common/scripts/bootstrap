#!/usr/bin/env bash
# Superseded 2026-09-27 by common/scripts/nomarchy, and kept so the old spelling -- in
# docs, in notes, in muscle memory -- still does the right thing:
#
#   bootstrap <host>            ->  nomarchy status <host>     (read-only, never sudo)
#   bootstrap <host> --apply    ->  nomarchy link <host> --yes (user level, never sudo)
#
# What bootstrap could never do -- packages and root-owned state -- is
# `nomarchy install base|desktop|host`.
nomarchy="$(dirname "$(readlink -f "$0")")/nomarchy"
host=${1:-}
[[ -n $host ]] || { echo "usage: ${0##*/} <host> [--apply]   (now: nomarchy status|link|install)" >&2; exit 1; }
if [[ ${2:-} == --apply ]]; then exec "$nomarchy" link "$host" --yes; fi
exec "$nomarchy" status "$host"
