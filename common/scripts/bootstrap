#!/usr/bin/env bash
# Bring a machine up to a nomarchy host, or report how far it already is.
#
#   bootstrap <host>            report what would change; change nothing
#   bootstrap <host> --apply    make the user-level changes
#
# Dry run is the default, matching the other scripts here (merge-show-dirs, subget). Run it
# with no --apply as often as you like: it doubles as a drift audit, answering "does this
# machine still match the repo".
#
# It never runs sudo. Root-level steps are printed from hosts/<host>/bootstrap/root-steps
# for a human to read and run, because sudo cannot be fed a password non-interactively here
# and because each of those steps deserves to be read before it happens.
#
# It never clobbers. A path that exists but is not the expected symlink is reported as a
# conflict and left exactly as it is -- on a fresh Arch install ~/.bashrc is a real file
# with real content, and deleting it unasked is not this script's decision to make.
#
# <host> is required and must already exist as hosts/<host>/. A new host is a directory
# somebody wrote on purpose, never a copy of another machine's -- see CLAUDE.md.

set -uo pipefail

repo="$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)"
cd "$repo" || exit 1

host="${1:-}"
apply=0
[[ ${2:-} == --apply ]] && apply=1

die() { printf '%s: %s\n' "${0##*/}" "$1" >&2; exit 1; }

[[ -n $host ]] || die "usage: ${0##*/} <host> [--apply]   (hosts: $(ls hosts | tr '\n' ' '))"
[[ -d hosts/$host ]] || die "no such host: hosts/$host -- a new host is written deliberately, not cloned"

ok=0; todo=0; conflict=0
say()  { printf '  %s\n' "$*"; }
good() { printf '  \033[32m✓\033[0m %s\n' "$*"; ((ok++)); }
want() { printf '  \033[33m→\033[0m %s\n' "$*"; ((todo++)); }
bad()  { printf '  \033[31m✗\033[0m %s\n' "$*"; ((conflict++)); }

manifest() { grep -vE '^\s*#|^\s*$' "$1" 2>/dev/null; }

printf '\n\033[1mnomarchy bootstrap — host %s — %s\033[0m\n' "$host" \
       "$( ((apply)) && echo 'APPLYING' || echo 'dry run, nothing will change')"

# ── Packages ────────────────────────────────────────────────────────────────
printf '\n\033[1mPackages\033[0m\n'
repo_pkgs=$(cat <(manifest common/packages/repo.txt) <(manifest "hosts/$host/packages/repo.txt") 2>/dev/null | sort -u)
aur_pkgs=$(cat <(manifest common/packages/aur.txt) <(manifest "hosts/$host/packages/aur.txt") 2>/dev/null | sort -u)
missing=$(comm -23 <(printf '%s\n' "$repo_pkgs") <(pacman -Qq | sort))
if [[ -z $missing ]]; then
  good "all $(printf '%s\n' "$repo_pkgs" | wc -l) repo packages present"
else
  want "$(printf '%s\n' "$missing" | wc -l) missing. Install with:"
  say  "    sudo pacman -S --needed $(printf '%s ' $missing)"
fi
aur_missing=$(comm -23 <(printf '%s\n' "$aur_pkgs") <(pacman -Qq | sort))
if [[ -z $aur_missing ]]; then
  good "all AUR packages present"
else
  want "AUR, no helper installed here -- build each with makepkg -si:"
  for p in $aur_missing; do say "    https://aur.archlinux.org/$p.git"; done
fi

# ── Toolchains ──────────────────────────────────────────────────────────────
# The gap between "the package is installed" and "the thing works". Arch's rustup package
# ships shims only: cargo and rustc are on PATH with no toolchain behind them, so a package
# check passes and every build fails. See common/bootstrap/toolchains.
printf '\n\033[1mToolchains\033[0m\n'
toolchains=$(cat <(manifest common/bootstrap/toolchains) <(manifest "hosts/$host/bootstrap/toolchains") 2>/dev/null)
if [[ -z $toolchains ]]; then
  say "none declared"
else
  while read -r mgr chain; do
    [[ -n ${mgr:-} && -n ${chain:-} ]] || continue
    case "$mgr" in
      rustup)
        if ! command -v rustup >/dev/null 2>&1; then
          want "rustup is not installed yet -- install the repo packages above, then re-run"
        elif active="$(rustup show active-toolchain 2>/dev/null)" && [[ -n $active ]]; then
          good "rustup: ${active%% *}"
        elif ((apply)); then
          if rustup default "$chain" >/dev/null 2>&1; then
            good "rustup: $chain (installed)"
          else
            bad "rustup default $chain failed -- run it by hand to see why"
          fi
        else
          want "rustup has no default toolchain: rustup default $chain"
        fi
        ;;
      *)
        bad "unknown toolchain manager '$mgr' -- teach ${0##*/} about it or fix the file"
        ;;
    esac
  done < <(printf '%s\n' "$toolchains")
fi

# ── Source builds ───────────────────────────────────────────────────────────
# Things that belong on every host but are not packages -- no PKGBUILD, no AUR entry, so
# the package manifests cannot express them. These DO run on --apply, unlike the AUR list:
# the boundary this script holds is sudo, and these install user-local into ~/.local/bin.
printf '\n\033[1mSource builds\033[0m\n'
builds=$(cat <(manifest common/bootstrap/builds) <(manifest "hosts/$host/bootstrap/builds") 2>/dev/null)
if [[ -z $builds ]]; then
  say "none declared"
else
  while read -r cmd dest url install; do
    [[ -n ${cmd:-} && -n ${dest:-} && -n ${url:-} && -n ${install:-} ]] || continue
    dir="${dest/#\~/$HOME}"
    # Probe ~/.local/bin explicitly as well as PATH: on a fresh host this may run from a
    # shell older than the ~/.bash_profile this script is laying down.
    if [[ -x $HOME/.local/bin/$cmd ]] || command -v "$cmd" >/dev/null 2>&1; then
      good "$cmd"
    elif ((apply)); then
      if [[ ! -d $dir/.git ]]; then
        mkdir -p "$(dirname "$dir")"
        if ! git clone "$url" "$dir" >/dev/null 2>&1; then
          bad "$cmd: git clone failed -- $url (is the GitHub key loaded? ssh-add -l)"
          continue
        fi
      fi
      if (cd "$dir" && eval "$install") >/dev/null 2>&1 \
         && { [[ -x $HOME/.local/bin/$cmd ]] || command -v "$cmd" >/dev/null 2>&1; }; then
        good "$cmd (built and installed)"
      else
        bad "$cmd: '$install' failed in $dest -- run it there by hand to see why"
      fi
    else
      want "$cmd is missing. Clone and build:"
      say  "    git clone $url $dest"
      say  "    cd $dest && $install"
    fi
  done < <(printf '%s\n' "$builds")
fi

# ── Symlinks ────────────────────────────────────────────────────────────────
printf '\n\033[1mSymlinks\033[0m\n'
while read -r src dst; do
  [[ -n ${src:-} && -n ${dst:-} ]] || continue
  target="${dst/#\~/$HOME}"
  want_path="$repo/$src"
  if [[ ! -e $want_path ]]; then bad "$src does not exist in the repo"; continue; fi
  if [[ -L $target ]]; then
    have="$(readlink -f "$target")"
    if [[ $have == "$(readlink -f "$want_path")" ]]; then good "$dst"; else bad "$dst -> $have (expected $src)"; fi
  elif [[ -e $target ]]; then
    bad "$dst exists and is not a symlink -- move it aside, then re-run"
  else
    if ((apply)); then
      mkdir -p "$(dirname "$target")" && ln -s "$want_path" "$target" && good "$dst (created)"
    else
      want "$dst -> $src"
    fi
  fi
done < <(cat common/bootstrap/links "hosts/$host/bootstrap/links" 2>/dev/null | grep -vE '^\s*#|^\s*$')

# ── Seeded files ────────────────────────────────────────────────────────────
# Files an application owns and rewrites, but which must EXIST before it has ever run.
# Copied once if absent, then left alone forever. Deliberately not diffed: their drift is
# the application working, and reporting it every run would train the eye to skip this
# section. See common/bootstrap/seeds for the full argument.
printf '\n\033[1mSeeded files\033[0m\n'
seeds=$(cat <(manifest common/bootstrap/seeds) <(manifest "hosts/$host/bootstrap/seeds") 2>/dev/null)
if [[ -z $seeds ]]; then
  say "none declared"
else
  while read -r src dst; do
    [[ -n ${src:-} && -n ${dst:-} ]] || continue
    target="${dst/#\~/$HOME}"
    if [[ ! -e $repo/$src ]]; then bad "$src does not exist in the repo"; continue; fi
    if [[ -e $target ]]; then
      good "$dst (present -- owned by the app, drift expected)"
    elif ((apply)); then
      if mkdir -p "$(dirname "$target")" && cp "$repo/$src" "$target"; then
        good "$dst (seeded from $src)"
      else
        bad "$dst could not be seeded from $src"
      fi
    else
      want "$dst <- $src (seed; absent)"
    fi
  done < <(printf '%s\n' "$seeds")
fi

# ── Root-owned copies ───────────────────────────────────────────────────────
# Cannot be symlinks, so they drift silently. Diffing them is the whole point of listing
# them: this turns "the repo and the machine quietly disagree" into a reported conflict.
printf '\n\033[1mRoot-owned copies\033[0m\n'
if [[ -f hosts/$host/bootstrap/copies ]]; then
  while read -r src dst; do
    [[ -n ${src:-} && -n ${dst:-} ]] || continue
    if [[ ! -e $dst ]]; then
      want "$dst not installed (see root steps)"
    elif [[ ! -r $dst ]]; then
      say "  ? $dst not readable as $USER -- cannot check"
    elif diff -q "$repo/$src" "$dst" >/dev/null 2>&1; then
      good "$dst"
    else
      bad "$dst DIFFERS from $src"
    fi
  done < <(grep -vE '^\s*#|^\s*$' "hosts/$host/bootstrap/copies")
else
  say "none declared"
fi

# ── User units ──────────────────────────────────────────────────────────────
printf '\n\033[1msystemd --user units\033[0m\n'
units=$(cat <(manifest common/bootstrap/units) <(manifest "hosts/$host/bootstrap/units") 2>/dev/null)
for u in $units; do
  state="$(systemctl --user is-enabled "$u" 2>/dev/null)"
  if [[ $state == enabled ]]; then
    good "$u"
  elif ((apply)); then
    systemctl --user daemon-reload
    systemctl --user enable --now "$u" >/dev/null 2>&1 && good "$u (enabled)" || bad "$u failed to enable"
  else
    want "$u (currently: ${state:-not found})"
  fi
done

# ── Root steps ──────────────────────────────────────────────────────────────
printf '\n\033[1mRoot steps — run these yourself\033[0m\n'
manifest "hosts/$host/bootstrap/root-steps" | while read -r line; do say "$line"; done

printf '\n\033[1m%d ok, %d to do, %d conflicts\033[0m\n\n' "$ok" "$todo" "$conflict"
((conflict == 0))
