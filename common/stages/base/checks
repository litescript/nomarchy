# State that is not a file or a unit. Each block is a check: `probe` runs as the user with
# NO sudo (nomarchy status runs it, and so may an agent), and exits 0 when the state is
# right; `fix` runs from `nomarchy install` when the probe fails, and may use sudo.

check timezone America/Indiana/Indianapolis
  probe [[ $(timedatectl show -p Timezone --value) == America/Indiana/Indianapolis ]]
  fix   sudo timedatectl set-timezone America/Indiana/Indianapolis

check locale en_US.UTF-8
  probe locale -a | grep -qx en_US.utf8 && [[ $(localectl status | sed -n 's/.*LANG=//p' | head -1) == en_US.UTF-8 ]]
  fix   sudo sed -i 's/^#\(en_US.UTF-8 UTF-8\)/\1/' /etc/locale.gen && sudo locale-gen && sudo localectl set-locale LANG=en_US.UTF-8
# pacman.conf is NOT copied wholesale (manifest §0): the package owns the file, and a
# whole-file copy would pin a stale one across pacman upgrades. The settings nomarchy
# means are declared one by one, and each fix is a targeted edit.
check pacman.conf: Color and ILoveCandy
  probe grep -qx 'Color' /etc/pacman.conf && grep -qx 'ILoveCandy' /etc/pacman.conf
  fix   sudo sed -i 's/^#Color$/Color/' /etc/pacman.conf && { grep -qx 'Color' /etc/pacman.conf || sudo sed -i '/^\[options\]$/a Color' /etc/pacman.conf; } && { grep -qx 'ILoveCandy' /etc/pacman.conf || sudo sed -i '/^Color$/a ILoveCandy' /etc/pacman.conf; }
# The mirrorlist is reflector's output (./files/reflector.conf): a list inherited from
# whatever machine ran pacstrap is exactly the "accidental mirror ordering" not to keep.
check mirrorlist generated by reflector (the declared mirror policy)
  probe grep -q '^# With: *reflector @/etc/xdg/reflector/reflector.conf' /etc/pacman.d/mirrorlist
  fix   sudo systemctl start reflector.service && grep -q '^# With: *reflector @/etc/xdg/reflector/reflector.conf' /etc/pacman.d/mirrorlist && grep -q '^Server' /etc/pacman.d/mirrorlist
# [multilib], for Steam and the lib32 GPU drivers it needs (Pete, 2026-09-28). Enabling a
# repository means syncing it, and a bare -Sy followed by installs is a partial upgrade --
# so the fix upgrades everything with it -- after the mirrorlist check above, so it syncs from
# the declared mirrors. The fix proves itself: pacman-conf must list it.
check pacman.conf: [multilib] enabled
  probe pacman-conf --repo-list | grep -qx multilib
  fix   sudo sed -i '/^#\[multilib\]$/,/^#Include/ s/^#//' /etc/pacman.conf && sudo pacman -Syu --noconfirm && pacman-conf --repo-list | grep -qx multilib
