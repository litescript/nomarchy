# Symlinks every nomarchy host gets: <repo path>  <system path>
# Tab- or space-separated; ~ expands. This file is the spec CLAUDE.md's table describes.
common/nvim			~/.config/nvim
common/kitty/kitty.conf		~/.config/kitty/kitty.conf
common/bash/bashrc		~/.bashrc
common/bash/bash_profile	~/.bash_profile
common/fuzzel/fuzzel.conf	~/.config/fuzzel/fuzzel.conf
common/browse_alias		~/code/browse_alias
common/systemd/ssh-agent.service	~/.config/systemd/user/ssh-agent.service
common/ssh/config		~/.ssh/config
common/irides/blueprints	~/.config/irides/blueprints

# common/scripts on PATH. The umbriel binds and the systemd units call these by BARE NAME
# so that neither file carries a home directory -- umbriel's spawn: resolves through PATH,
# and the units use %h/.local/bin. These links are what makes that true, so they are not
# optional decoration: without them, nine keybinds go quiet.
#
# Everything in common/scripts except bootstrap, host-survey and the two pre-wipe-*
# scripts. Those four are repo operations run from the checkout: bootstrap and host-survey
# have names too generic to want on PATH, and the pre-wipe pair runs on a machine's OLD OS
# before this file has ever been applied, so ~/.local/bin does not exist yet.
common/scripts/askpass-fuzzel		~/.local/bin/askpass-fuzzel
common/scripts/nomarchy			~/.local/bin/nomarchy
common/scripts/noctalia-snapshot	~/.local/bin/noctalia-snapshot
common/scripts/noctalia-plugins	~/.local/bin/noctalia-plugins
common/scripts/backup-daily		~/.local/bin/backup-daily
common/scripts/backup-legal-to-nas	~/.local/bin/backup-legal-to-nas
common/scripts/launch-or-focus		~/.local/bin/launch-or-focus
common/scripts/lock-and-blank		~/.local/bin/lock-and-blank
common/scripts/merge-show-dirs		~/.local/bin/merge-show-dirs
common/scripts/proxmox-rescue-toolkit	~/.local/bin/proxmox-rescue-toolkit
common/scripts/proxmox-rescue-usb	~/.local/bin/proxmox-rescue-usb
common/scripts/screenshot-region		~/.local/bin/screenshot-region
common/scripts/spotify-limited		~/.local/bin/spotify-limited
common/scripts/umbriel-update		~/.local/bin/umbriel-update
common/scripts/universal-clipboard	~/.local/bin/universal-clipboard
# Authored git config (manifest §8 D). git writes `git config --global` THROUGH the link
# (a lock file renamed onto the resolved target -- tested, 2026-09-28), so a link is safe
# here where it would not be for an app that renames over the path. git never writes
# ignore. Not declared: ~/.config/bat/config, which Noctalia's bat template generates.
common/git/gitconfig		~/.gitconfig
common/git/ignore		~/.config/git/ignore
