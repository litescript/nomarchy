# Symlinks every nomarchy host gets: <repo path>  <system path>
# Tab- or space-separated; ~ expands. This file is the spec CLAUDE.md's table describes.
common/nvim			~/.config/nvim
common/kitty/kitty.conf		~/.config/kitty/kitty.conf
common/bash/bashrc		~/.bashrc
common/bash/bash_profile	~/.bash_profile
common/fuzzel/fuzzel.conf	~/.config/fuzzel/fuzzel.conf
common/browse_alias		~/code/browse_alias
common/systemd/ssh-agent.service	~/.config/systemd/user/ssh-agent.service
