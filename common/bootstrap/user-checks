# User-level state every host needs that is not a link, seed or unit. Run by `nomarchy
# link` after the source builds. Format: see common/stages/base/checks -- `probe` runs
# with no sudo and must be read-only; `fix` must not sudo either at this level.

# Irides' Noctalia plugin, behind Mod+Alt+T. It lives in Noctalia's own settings.toml,
# which nothing here may write, and it can only be registered while Noctalia is RUNNING --
# so on a fresh host this fails until the first graphical login, and passes on the `link`
# after it. The source is only added when absent: whether `source add` is safe to repeat
# has not been verified (the Irides session's caveat, 2026-09-27). Enabling completes in the
# background ("ok (exporting in background)"), so the fix waits until Noctalia reports the
# plugin enabled -- the VM rehearsal's status, run seconds later, still saw it off.
# The PROBE tolerates a settling reload too: a theme change (irides apply, run by the check
# below) makes Noctalia reload its plugins, and a status run in that window saw the plugin
# missing -- the formal release candidate, 2026-09-28. Not running at all fails at once;
# running, it gets up to 15 s. Still read-only.
check Irides Noctalia plugin enabled (Mod+Alt+T)
  probe pgrep -x noctalia >/dev/null || exit 1; for i in $(seq 30); do noctalia msg plugins list 2>/dev/null | grep -qE '^litescript/irides .* enabled' && exit 0; sleep 0.5; done; exit 1
  fix   { noctalia msg plugins source list | grep -qE '^irides ' || noctalia msg plugins source add irides path ~/code/irides/noctalia-plugins; } && noctalia msg plugins enable litescript/irides && for i in $(seq 20); do noctalia msg plugins list 2>/dev/null | grep -qE '^litescript/irides .* enabled' && exit 0; sleep 0.5; done; exit 1

# Noctalia's settings are seeded from a snapshot in the repo (hosts/<host>/noctalia/). A
# snapshot is only as good as its date, so this says when live has moved past it -- a
# setting changed today would otherwise miss the next rebuild without anyone noticing.
check Noctalia settings captured in the repo (hosts/<host>/noctalia/settings.toml)
  probe common/scripts/noctalia-snapshot --check
  manual run noctalia-snapshot, review the diff, commit -- otherwise the next rebuild starts from the older snapshot

# The seeded theme names a palette Irides GENERATES (custom_palette = "irides-<name>"), not
# a versioned file. Regenerated from the blueprint once Irides is built; `irides apply`
# activates it through Noctalia, so like the plugin this passes from the first graphical
# login. It needs the wallpaper the blueprint pins, in ~/Pictures.
check Irides palette for Noctalia's active theme exists
  probe p=$(sed -n 's/^custom_palette = "\(.*\)"$/\1/p' ~/.local/state/noctalia/settings.toml 2>/dev/null); [[ $p != irides-* ]] || [[ -f ~/.config/noctalia/palettes/$p.json ]]
  fix   p=$(sed -n 's/^custom_palette = "\(.*\)"$/\1/p' ~/.local/state/noctalia/settings.toml); irides apply "${p#irides-}"

# Coordinates are stripped from every snapshot (public repo), so a rebuilt host has none.
check Noctalia location set (weather, night light)
  probe [[ ! -f ~/.local/state/noctalia/settings.toml ]] || grep -q '^latitude' ~/.local/state/noctalia/settings.toml
  manual set it in Noctalia's settings -- the repo deliberately never carries your coordinates

# umbriel is two invariants, checked SEPARATELY (Atlas's distinction, 2026-09-27):
#
#   declared revision -- the installed umbriel and portal are exactly the revs pinned in
#     common/umbriel/UPSTREAM. Fails after a pull that moved the pins, or on a host that
#     installed off-pin by hand.
#   compatibility -- the installed umbriel ACCEPTS the live config, palette included. Can
#     fail with the pins exact: a `pacman -Syu` bringing a Noctalia whose palette template
#     speaks newer or older umbriel breaks the pair without anyone touching umbriel.
#
# Neither can be fixed here -- installing needs sudo, and a compatibility failure needs a
# human to decide which side moves -- so both are manual; umbriel-update's survey says why.
check umbriel and its portal installed at the pinned revisions (common/umbriel/UPSTREAM)
  probe common/scripts/umbriel-update --check-pins
  manual umbriel-update --sync --apply installs exactly the pins, gated on the live config (or --apply to move them forward)

check installed umbriel accepts the live config (palette included)
  probe common/scripts/umbriel-update --check-config
  manual run umbriel-update: its survey shows whether the config is ahead of the binary (install the pins) or Noctalia's palette is out of step with umbriel (wait for, or move to, a matching pair)
