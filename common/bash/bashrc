# update my kitty fork from upstream, apply my mouse-selection-from-gutter patch, test, build, confirm, install
pete-kitty-update() {
  local repo="$HOME/code/kitty-fork/kitty"
  local branch="pete/mouse-selection-from-gutter"
  local prefix="$HOME/.local/opt/kitty-pete"

  (
    set -e

    cd "$repo" || return

    echo "==> Checking working tree"
    if [[ -n "$(git status --porcelain)" ]]; then
      echo "ERROR: Working tree is dirty. Aborting."
      git status --short
      return 1
    fi

    echo "==> Updating pristine master"
    git switch master
    git fetch upstream
    git merge --ff-only upstream/master

    echo "==> Rebasing Pete Kitty"
    git switch "$branch"
    git rebase master

    echo "==> Building"
    ./dev.sh build

    echo "==> Running mouse tests"
    ./test.py --module mouse

    echo "==> Running configuration tests"
    ./test.py --module options

    echo "==> Checking diff"
    git diff --check

    echo
    echo "All checks passed."
    echo "Current branch: $(git branch --show-current)"
    echo "Version:"
    ./kitty/launcher/kitty --version
    echo

    read -r -p "Install this build to $prefix? [y/N] " answer
    [[ "$answer" =~ ^[Yy]$ ]] || {
      echo "Not installed. Existing Pete Kitty remains unchanged."
      return 0
    }

    echo "==> Installing Pete Kitty"
    PATH="$PWD/dependencies/linux-amd64/bin:$PATH" \
      python3 setup.py linux-package --prefix "$prefix"

    echo "==> Verifying installed version"
    "$prefix/bin/kitty" --version

    echo
    echo "Done."
    echo "kitty          -> $(command -v kitty)"
    echo "/usr/bin/kitty -> packaged fallback"
  )
}

# --- zoxide ---
# Omarchy hand-rolled a `zd` wrapper and aliased cd to it. zoxide does this itself with
# --cmd, so the wrapper is not needed: `cd` gains frecency, and `cdi` is interactive.
eval "$(zoxide init bash --cmd cd)"

# --- fzf helpers ---
# Rebuilt rather than carried. The old pair came from Omarchy's rc and switched preview on
# $TERM == xterm-kitty; this checks for the kitten binary instead, which is what actually
# has to exist, and works in any terminal that ships it.
if command -v kitten >/dev/null 2>&1; then
  ff() {
    fzf --preview 'case $(file --mime-type -b {}) in
        image/*) kitten icat --clear --transfer-mode=memory --stdin=no \
                   --place="${FZF_PREVIEW_COLUMNS}x${FZF_PREVIEW_LINES}@0x0" {} ;;
        *) bat --style=numbers --color=always {} ;;
      esac'
  }
else
  ff() { fzf --preview 'bat --style=numbers --color=always {}'; }
fi

# Edit the file picked with ff.
eff() { local f; f="$(ff)" && [[ -n $f ]] && "$EDITOR" "$f"; }

# --- Backup status summary (auto-print on login) ---
if [[ -f "$HOME/Logs/code-backup.log" ]]; then
  last_line=$(tail -n 5 "$HOME/Logs/code-backup.log" | grep -E '\[20[0-9]{2}-[0-9]{2}-[0-9]{2}' | tail -n 1)
  if echo "$last_line" | grep -q "NAS available"; then
    echo -e "\033[1;32m☑  Last backup succeeded on NAS — $(echo "$last_line" | cut -d']' -f1 | tr -d '[')\033[0m"
  elif echo "$last_line" | grep -q "WARN: NAS not available"; then
    echo -e "\033[1;33m⚠  Last backup used local fallback — $(echo "$last_line" | cut -d']' -f1 | tr -d '[')\033[0m"
  fi
fi

